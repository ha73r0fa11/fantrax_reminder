# ===== Fantrax =====
# ID лиги (из URL: .../fantasy/league/<ID>/home)
FANTRAX_LEAGUE_ID=rwoc4s02mrui4mac

# ===== Telegram =====
# Токен бота: напишите @BotFather -> /newbot и скопируйте токен.
TELEGRAM_BOT_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Кому писать, когда участник нажимает «Старт» (ваш chat_id).
# Пусто — бот привязывает участников молча. Узнать: python -m bot.get_chat_id
ADMIN_CHAT_ID=

# ===== Привязка команд к участникам =====
# Файл соответствия «команда Fantrax -> Telegram chat_id».
# Узнать chat_id участника: python -m bot.get_chat_id
# Посмотреть команды и привязку: python -m bot.mapping
# В Docker переопределяется на /data/mapping.json
MAPPING_FILE=mapping.json

# ===== Проверка =====
# Интервал опроса Fantrax, в минутах.
POLL_INTERVAL_MINUTES=30
# Сдвиг сетки запуска в минутах: при интервале 30 — проверки в :20 и :50.
POLL_ALIGN_MINUTES=20

# ===== Прочее =====
# Уровень логирования: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# Режим без реальной отправки в Telegram (только лог). true/false
DRY_RUN=false

# Файл состояния (в Docker переопределяется на /data/state.json)
STATE_FILE=state.json
